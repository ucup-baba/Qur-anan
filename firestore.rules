rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /userSync/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
